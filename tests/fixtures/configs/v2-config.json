{
  "version": 2,
  "targets": {
    "default": {
      "bucket_name": "example-bucket",
      "local_path": "./dist",
      "bucket_path": "/",
      "acl": "public-read"
    },
    "staging": {
      "bucket_name": "example-staging-bucket",
      "local_path": "./dist",
      "bucket_path": "/staging/",
      "delete": true,
      "cloudfront_id": "E1234567890ABC"
    }
  },
  "defaults": {
    "caches": {
      "text/javascript": 2592000,
      "text/css": 2592000,
      "image/*": 31536000,
      "text/html": 0
    },
    "exclude": [
      ".DS_Store",
      "*.map"
    ],
    "gitignore": true
  }
}
